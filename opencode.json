{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*key.properties": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*key.properties": "deny"
    },
    "bash": {
      "*": "ask",
      "flutter analyze*": "allow",
      "flutter test*": "allow",
      "flutter pub get*": "allow",
      "dart format*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm *": "deny",
      "git push*": "deny",
      "*.env*": "deny",
      "*.jks*": "deny",
      "*key.properties*": "deny"
    }
  }
}
